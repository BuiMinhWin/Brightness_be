{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BrightnessDb": "",
    "Redis": "localhost:6379"
  },
  "MySerilog": {
    "FileName": "AuthenticationApi"
  },
  "Authentication": {
    "Key": "",
    "Issuer": "https://localhost:5000",
    "Audience": "https://localhost:5000",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "RequireHttpsMetadata": false,
    "ClockSkewMinutes": 2
  },
  "RateLimit": {
    "LoginAttempts": 5,
    "LoginWindowMinutes": 15,
    "RefreshTokenAttempts": 10,
    "RefreshTokenWindowMinutes": 5,
    "GeneralApiAttempts": 100,
    "GeneralApiWindowMinutes": 1
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Database": 0,
    "KeyPrefix": "brightness:auth:",
    "ConnectTimeout": "00:00:05",
    "SyncTimeout": "00:00:05",
    "ConnectRetry": 3,
    "AbortOnConnectFail": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://brightnessweb.vercel.app",
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "CookieSettings": {
    "RefreshTokenCookieName": "refreshToken",
    "SecureInProduction": true,
    "SameSite": "Lax"
  }
}
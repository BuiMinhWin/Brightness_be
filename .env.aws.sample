# File mẫu cho các biến môi trường trên AWS EC2
# Đổi tên file này thành .env và điền các giá trị thực tế

# AWS Account & Region
AWS_ACCOUNT_ID=702166530152
AWS_REGION=ap-southeast-2

# RDS PostgreSQL Connection
POSTGRES_HOST=your-rds-endpoint.ap-southeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_rds_password

# JWT Settings
JWT_SECRET=a_very_strong_and_long_secret_key_for_production
JWT_ISSUER=brightness_production_issuer
JWT_AUDIENCE=brightness_production_audience
JWT_EXPIRY=1440 # 24 hours

# Mailgun/SMTP Settings
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mailgun_username
MAIL_PASSWORD=your_mailgun_password
MAIL_SENDER=noreply@yourdomain.com
MAIL_SENDER_NAME=BrightNess App

# AWS S3 Bucket for Media
AWS_S3_BUCKET=brightness-media-production
AWS_ACCESS_KEY=your_aws_iam_user_access_key
AWS_SECRET_KEY=your_aws_iam_user_secret_key

# Stripe API Keys
STRIPE_API_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# OpenAI API Key
OPENAI_API_KEY=sk-your_openai_api_key
